<Window x:Class="DoAn_banPRO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ViewModels="clr-namespace:DoAn_banPRO.ViewModels"
        xmlns:Views="clr-namespace:DoAn_banPRO.Views"
        mc:Ignorable="d"
        Title="Quản Lý Kho Điện Tử"
        Height="760"
        Width="1280"
        MinHeight="700"
        MinWidth="1150"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <ViewModels:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type ViewModels:LinhKienViewModel}">
            <Views:LinhKienView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ViewModels:LoaiHangViewModel}">
            <Views:LoaiHangView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ViewModels:PhieuNhapViewModel}">
            <Views:PhieuNhapView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ViewModels:PhieuXuatViewModel}">
            <Views:PhieuXuatView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ViewModels:NhaCungCapViewModel}">
            <Views:NhaCungCapView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ViewModels:ThongKeViewModel}">
            <Views:ThongKeView/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                Padding="22"
                CornerRadius="0,24,24,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="0,4,0,24">
                    <Border Width="58"
                            Height="58"
                            CornerRadius="18"
                            Background="#2563EB"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12">
                        <TextBlock Text="⚡"
                                   FontSize="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"/>
                    </Border>

                    <TextBlock Text="KHO ĐIỆN TỬ"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="22"/>

                    <TextBlock Text="Quản lý linh kiện chuyên nghiệp"
                               Foreground="#94A3B8"
                               FontSize="13"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- User Card -->
                <Border Grid.Row="1"
                        Background="#1E293B"
                        CornerRadius="16"
                        Padding="14"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Tài khoản đang đăng nhập"
                                   Foreground="#94A3B8"
                                   FontSize="12"/>

                        <TextBlock Text="{Binding UserInfo}"
                                   Foreground="#F8FAFC"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Menu -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="DANH MỤC"
                               Foreground="#64748B"
                               FontSize="12"
                               FontWeight="Bold"
                               Margin="4,0,0,10"/>

                    <Button Command="{Binding ShowLinhKienCommand}"
                            Style="{StaticResource NavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🧩" FontSize="17" Foreground="White"/>
                            <TextBlock Grid.Column="1" Text="Linh kiện" Foreground="#E5E7EB"/>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowLoaiHangCommand}"
                            Style="{StaticResource NavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🏷" FontSize="17" Foreground="White"/>
                            <TextBlock Grid.Column="1" Text="Loại hàng" Foreground="#E5E7EB"/>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowNhaCungCapCommand}"
                            Style="{StaticResource NavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🏢" FontSize="17" Foreground="White"/>
                            <TextBlock Grid.Column="1" Text="Nhà cung cấp" Foreground="#E5E7EB"/>
                        </Grid>
                    </Button>

                    <TextBlock Text="NGHIỆP VỤ KHO"
                               Foreground="#64748B"
                               FontSize="12"
                               FontWeight="Bold"
                               Margin="4,22,0,10"/>

                    <Button Command="{Binding ShowPhieuNhapCommand}"
                            Style="{StaticResource NavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📥" FontSize="17" Foreground="White"/>
                            <TextBlock Grid.Column="1" Text="Nhập kho" Foreground="#E5E7EB"/>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowPhieuXuatCommand}"
                            Style="{StaticResource NavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📤" FontSize="17" Foreground="White"/>
                            <TextBlock Grid.Column="1" Text="Xuất kho" Foreground="#E5E7EB"/>
                        </Grid>
                    </Button>

                    <Button Command="{Binding ShowThongKeCommand}"
                            Style="{StaticResource NavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📊" FontSize="17" Foreground="White"/>
                            <TextBlock Grid.Column="1" Text="Thống kê - báo cáo" Foreground="#E5E7EB"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Logout -->
                <Button Grid.Row="3"
                        Command="{Binding LogoutCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Background="#334155"
                        Style="{StaticResource NavButtonStyle}"
                        Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🚪" FontSize="17" Foreground="White"/>
                        <TextBlock Grid.Column="1" Text="Đăng xuất" Foreground="#F8FAFC"/>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Style="{StaticResource CardStyle}"
                    Padding="22"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Bảng điều khiển hệ thống"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMainBrush}"/>

                        <TextBlock Text="Quản lý linh kiện, nhập kho, xuất kho và báo cáo tồn kho"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#EFF6FF"
                            CornerRadius="12"
                            Padding="14,8"
                            VerticalAlignment="Center">
                        <TextBlock Text="WPF • MVVM • SQL Server"
                                   Foreground="#1D4ED8"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Page container -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding CurrentViewModel}"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>