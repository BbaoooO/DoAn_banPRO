<Window x:Class="DoAn_banPRO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoAn_banPRO"
        xmlns:ViewModels="clr-namespace:DoAn_banPRO.ViewModels"
        xmlns:Views="clr-namespace:DoAn_banPRO.Views"
        mc:Ignorable="d"
        Title="Quản Lý Kho Điện Tử" Height="700" Width="1200" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <ViewModels:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <DataTemplate DataType="{x:Type ViewModels:LinhKienViewModel}">
            <Views:LinhKienView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:LoaiHangViewModel}">
            <Views:LoaiHangView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:PhieuNhapViewModel}">
            <Views:PhieuNhapView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:PhieuXuatViewModel}">
            <Views:PhieuXuatView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:NhaCungCapViewModel}">
            <Views:NhaCungCapView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:ThongKeViewModel}">
            <Views:ThongKeView/>
        </DataTemplate>
    </Window.Resources>
    
    <Grid Background="#f5f7fa">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Menu Left -->
        <Border Grid.Column="0" Background="#2c3e50" CornerRadius="0,15,15,0" Margin="0,0,10,0" Padding="10">
            <StackPanel Margin="10">
                <TextBlock Text="MENU CHÍNH" FontWeight="Bold" Foreground="White" FontSize="20" Margin="0,10,0,20" HorizontalAlignment="Center"/>
                <Border Background="#34495e" CornerRadius="10" Padding="10" Margin="0,0,0,30">
                    <TextBlock Text="{Binding UserInfo}" FontSize="14" Foreground="#ecf0f1" FontStyle="Italic" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>
                
                <Button Content="Linh Kiện" Height="40" Margin="0,8" Command="{Binding ShowLinhKienCommand}" Background="#3498db" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
                <Button Content="Loại Hàng" Height="40" Margin="0,8" Command="{Binding ShowLoaiHangCommand}" Background="#3498db" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
                
                <Button Content="Nhà Cung Cấp" Height="40" Margin="0,8" Command="{Binding ShowNhaCungCapCommand}" Background="#3498db" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
                <Button Content="Nhập Kho" Height="40" Margin="0,8" Command="{Binding ShowPhieuNhapCommand}" Background="#27ae60" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
                <Button Content="Xuất Kho" Height="40" Margin="0,8" Command="{Binding ShowPhieuXuatCommand}" Background="#e74c3c" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
                <Button Content="Thống Kê" Height="40" Margin="0,8" Command="{Binding ShowThongKeCommand}" Background="#f39c12" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
                
                <Button Content="Đăng Xuất" Height="40" Margin="0,50,0,0" Command="{Binding LogoutCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Background="#7f8c8d" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Border Grid.Column="1" Background="White" CornerRadius="10" Margin="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="10" Opacity="0.2"/>
            </Border.Effect>
            <ContentControl Content="{Binding CurrentViewModel}"/>
        </Border>

    </Grid>
</Window>
