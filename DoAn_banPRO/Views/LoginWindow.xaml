<Window x:Class="DoAn_banPRO.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ViewModels="clr-namespace:DoAn_banPRO.ViewModels"
        Title="ĐĂNG NHẬP HỆ THỐNG" Height="300" Width="400" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <ViewModels:LoginViewModel/>
    </Window.DataContext>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="ĐĂNG NHẬP" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" Grid.Row="0"/>
        
        <TextBlock Text="Tài khoản:" Grid.Row="1" Margin="0,0,0,5"/>
        <TextBox Text="{Binding TaiKhoan, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Margin="0,0,0,22" Padding="5"/>
        
        <TextBlock Text="Mật khẩu:" Grid.Row="3" Margin="0,0,0,5"/>
        <TextBox Text="{Binding MatKhau, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Margin="0,0,0,20" Padding="5"/>
        <!-- Note: Real App should use PasswordBox with an attached property for binding -->
        
        <Button Content="Đăng nhập" Command="{Binding LoginCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                Grid.Row="5" Width="100" Height="35" HorizontalAlignment="Center"/>
    </Grid>
</Window>