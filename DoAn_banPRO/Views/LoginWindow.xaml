<Window x:Class="DoAn_banPRO.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ViewModels="clr-namespace:DoAn_banPRO.ViewModels"
        Title="Đăng nhập hệ thống"
        Height="520"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI">

	<Window.DataContext>
		<ViewModels:LoginViewModel/>
	</Window.DataContext>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="1.15*"/>
			<ColumnDefinition Width="0.85*"/>
		</Grid.ColumnDefinitions>

		<!-- LEFT BRAND AREA -->
		<Border Grid.Column="0"
                CornerRadius="0,28,28,0"
                Padding="46">
			<Border.Background>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
					<GradientStop Color="#0F172A" Offset="0"/>
					<GradientStop Color="#1D4ED8" Offset="1"/>
				</LinearGradientBrush>
			</Border.Background>

			<StackPanel VerticalAlignment="Center">
				<Border Width="76"
                        Height="76"
                        CornerRadius="24"
                        Background="#FFFFFF"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,24">
					<TextBlock Text="⚡"
                               FontSize="38"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
				</Border>

				<TextBlock Text="QUẢN LÝ KHO ĐIỆN TỬ"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>

				<TextBlock Text="Hệ thống hỗ trợ quản lý linh kiện, nhập kho, xuất kho, nhà cung cấp và báo cáo tồn kho."
                           Foreground="#Dbeafe"
                           FontSize="15"
                           TextWrapping="Wrap"
                           LineHeight="24"
                           Margin="0,18,0,0"/>

				<StackPanel Margin="0,34,0,0">
					<TextBlock Text="✓ Giao diện WPF hiện đại"
                               Foreground="#EFF6FF"
                               FontSize="14"
                               Margin="0,5"/>

					<TextBlock Text="✓ Mô hình MVVM rõ ràng"
                               Foreground="#EFF6FF"
                               FontSize="14"
                               Margin="0,5"/>

					<TextBlock Text="✓ Dữ liệu SQL Server"
                               Foreground="#EFF6FF"
                               FontSize="14"
                               Margin="0,5"/>
				</StackPanel>
			</StackPanel>
		</Border>

		<!-- LOGIN FORM -->
		<Grid Grid.Column="1" Margin="42">
			<Border Style="{StaticResource CardStyle}"
                    Padding="30"
                    VerticalAlignment="Center">
				<StackPanel>
					<TextBlock Text="Đăng nhập"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMainBrush}"/>

					<TextBlock Text="Vui lòng nhập tài khoản để tiếp tục"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,6,0,28"/>

					<TextBlock Text="Tài khoản"
                               FontWeight="SemiBold"
                               Margin="0,0,0,7"/>

					<TextBox Text="{Binding TaiKhoan, UpdateSourceTrigger=PropertyChanged}"
                             Height="42"
                             Margin="0,0,0,18"/>

					<TextBlock Text="Mật khẩu"
                               FontWeight="SemiBold"
                               Margin="0,0,0,7"/>

					<TextBox Text="{Binding MatKhau, UpdateSourceTrigger=PropertyChanged}"
                             Height="42"
                             Margin="0,0,0,26"/>

					<Button Content="Đăng nhập"
                            Command="{Binding LoginCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="44"
                            FontSize="15"/>

					<Border Background="#F8FAFC"
                            CornerRadius="12"
                            Padding="12"
                            Margin="0,22,0,0">
						<TextBlock Text="Gợi ý: đăng nhập bằng tài khoản đã có trong bảng NguoiDung."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"/>
					</Border>
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
</Window>