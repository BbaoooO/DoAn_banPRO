<UserControl x:Class="DoAn_banPRO.Views.LinhKienView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DoAn_banPRO.Views"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="QUẢN LÝ LINH KIỆN" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <!-- Form Control -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Mã linh kiện:" Grid.Row="0" Grid.Column="0" Margin="5"/>
            <TextBox Text="{Binding SelectedLinhKien.MaLK}" Grid.Row="0" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Tên linh kiện:" Grid.Row="0" Grid.Column="2" Margin="5"/>
            <TextBox Text="{Binding SelectedLinhKien.TenLK}" Grid.Row="0" Grid.Column="3" Margin="5"/>
            
            <TextBlock Text="Tồn kho:" Grid.Row="1" Grid.Column="0" Margin="5"/>
            <TextBox Text="{Binding SelectedLinhKien.TonKho}" Grid.Row="1" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Đơn giá:" Grid.Row="1" Grid.Column="2" Margin="5"/>
            <TextBox Text="{Binding SelectedLinhKien.DonGia}" Grid.Row="1" Grid.Column="3" Margin="5"/>

            <TextBlock Text="Đơn vị:" Grid.Row="1" Grid.Column="4" Margin="5"/>
            <TextBox Text="{Binding SelectedLinhKien.DonViTinh}" Grid.Row="1" Grid.Column="5" Margin="5"/>

            <TextBlock Text="Mã loại:" Grid.Row="2" Grid.Column="0" Margin="5"/>
            <TextBox Text="{Binding SelectedLinhKien.MaLoai}" Grid.Row="2" Grid.Column="1" Margin="5"/>

            <TextBlock Text="Mã NCC:" Grid.Row="2" Grid.Column="2" Margin="5"/>
            <TextBox Text="{Binding SelectedLinhKien.MaNCC}" Grid.Row="2" Grid.Column="3" Margin="5"/>
        </Grid>
        
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,5,0"/>
            <Button Content="Tìm" Command="{Binding SearchCommand}" Width="70" Margin="0,0,15,0"/>
            
            <Button Content="Tạo mới" Command="{Binding AddCommand}" Width="90" Margin="0,0,5,0"/>
            <Button Content="Cập nhật" Command="{Binding UpdateCommand}" Width="90" Margin="0,0,5,0"/>
            <Button Content="Xóa" Command="{Binding DeleteCommand}" Width="90"/>
        </StackPanel>

        <!-- Data Grid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding LinhKienList}" SelectedItem="{Binding SelectedLinhKien}" 
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Mã linh kiện"
									Binding="{Binding MaLK}"
									Width="130"
									MinWidth="120"/>

				<DataGridTextColumn Header="Tên linh kiện"
									Binding="{Binding TenLK}"
									Width="2*"
									MinWidth="220"/>

				<DataGridTextColumn Header="Tồn kho"
									Binding="{Binding TonKho}"
									Width="110"
									MinWidth="100"/>

				<DataGridTextColumn Header="Đơn vị"
									Binding="{Binding DonViTinh}"
									Width="110"
									MinWidth="100"/>

				<DataGridTextColumn Header="Đơn giá"
									Binding="{Binding DonGia, StringFormat=N0}"
									Width="150"
									MinWidth="130"/>

				<DataGridTextColumn Header="Loại hàng"
									Binding="{Binding TenLoai}"
									Width="180"
									MinWidth="150"/>

				<DataGridTextColumn Header="Nhà cung cấp"
									Binding="{Binding TenNCC}"
									Width="2*"
									MinWidth="220"/>
			</DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>